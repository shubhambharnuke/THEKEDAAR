# Backend Configuration
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/thekedar?sslmode=require

# Better Auth & JWT
BETTER_AUTH_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Ethereum Sepolia Blockchain
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
BLOCKCHAIN_CHAIN_ID=11155111
DOCUMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SIGNER_PRIVATE_KEY=your_private_key_without_0x
