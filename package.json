{
  "name": "thekedar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "THEKEDAR - College Resource Booking & Permission Management System",
  "workspaces": [
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
