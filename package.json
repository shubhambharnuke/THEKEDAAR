    "test:web": "npm run test --workspace=apps/web",
    "compile:contracts": "npm run compile --workspace=contracts",
    "test:contracts": "npm run test --workspace=contracts"
  },
  "keywords": [
    "resource-booking",
    "fastapi",
    "nextjs",
    "ethereum",
    "sepolia",
    "better-auth",
    "solidity"
